# =====================================================================
# Sitio web E.S.E. Hospital Rosario Pumarejo de López
#
# Copia este archivo a `.env` y ajusta los valores.
# `.env` NUNCA se sube al repositorio: contiene credenciales.
# =====================================================================

# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------
# local | pruebas | produccion
# Fuera de "local" no se muestran trazas de error aunque APP_DEBUG sea true.
APP_ENTORNO=local
APP_DEBUG=true
APP_URL=http://hr.test
APP_ZONA_HORARIA=America/Bogota

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_NOMBRE=hrpl
DB_USUARIO=root
DB_PASSWORD=

# ---------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------
# En local, Mailpit (viene con Laragon) captura todo sin enviar nada real.
# Interfaz web: http://localhost:8025
CORREO_DSN=smtp://127.0.0.1:1025
CORREO_REMITENTE=no-responder@hrplopez.gov.co
CORREO_REMITENTE_NOMBRE="E.S.E. Hospital Rosario Pumarejo de Lopez"

# ---------------------------------------------------------------------
# Caché
# ---------------------------------------------------------------------
# Vacío = la aplicación usa el respaldo en tabla MySQL (CLAUDE.md §3).
# La extensión `redis` de PHP no viene en la instalación de Laragon,
# así que dejarlo vacío es lo correcto hasta que se instale.
REDIS_DSN=

# ---------------------------------------------------------------------
# Sesión
# ---------------------------------------------------------------------
SESION_NOMBRE=hrpl_sesion
SESION_VIDA_MINUTOS=120

# ---------------------------------------------------------------------
# IA del panel (Fase 8, opcional)
# ---------------------------------------------------------------------
# Claves de API por proveedor. Vacías = ese proveedor aparece "sin clave"
# en Panel -> IA y el asistente no puede activarse con el.
# Activar/desactivar, proveedor y modelo se manejan desde el panel.
IA_CLAVE_ANTHROPIC=
IA_CLAVE_OPENAI=
