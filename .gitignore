# Dependencias
/vendor/
/node_modules/

# Entorno — nunca credenciales en el repositorio (CLAUDE.md §3)
.env
.env.*
!.env.example

# Almacenamiento en tiempo de ejecución. La estructura sí se versiona (.gitkeep),
# el contenido no: son datos del hospital, no código.
/storage/uploads/*
/storage/cache/*
/storage/logs/*
/storage/backups/*
/storage/cuentas/*
# Documentos oficiales descargados del sitio vigente para cargarlos al módulo
# documental. No son código: entran por el panel, no por git.
/storage/documentos-ita/*
!/storage/*/.gitkeep

# Compilado por Tailwind / Vite
/public/build/
/public/hot

# Pruebas y herramientas
/.phpunit.cache/
.phpunit.result.cache
/coverage/
/test-results/
/playwright-report/
/.playwright/

# Editores y sistema operativo
/.idea/
/.vscode/*
!/.vscode/extensions.json
/.fleet/
.DS_Store
Thumbs.db
desktop.ini

# Laragon
/.laragon/

# Exportaciones de la herramienta de diseño (Stitch). Son material de
# referencia que se regenera, no código: pesan y no aportan historia.
/stitch*.zip
/stitch_hospital_digital_experience_home/
