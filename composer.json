{
    "name": "hrpl/sitio-web",
    "description": "Sitio web institucional E.S.E. Hospital Rosario Pumarejo de López",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "dompdf/dompdf": "^3.1",
        "symfony/config": "^7.3",
        "symfony/console": "^7.3",
        "symfony/dependency-injection": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/html-sanitizer": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/routing": "^7.3",
        "symfony/translation": "^7.3",
        "symfony/validator": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/var-dumper": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:feature": "phpunit --testsuite feature",
        "migrate": "doctrine-migrations migrate --configuration=config/migraciones.php --db-configuration=config/migraciones-bd.php --no-interaction",
        "migrate:down": "doctrine-migrations migrate prev --configuration=config/migraciones.php --db-configuration=config/migraciones-bd.php --no-interaction",
        "migrate:status": "doctrine-migrations status --configuration=config/migraciones.php --db-configuration=config/migraciones-bd.php",
        "migrate:generar": "doctrine-migrations generate --configuration=config/migraciones.php --db-configuration=config/migraciones-bd.php"
    }
}
