root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,ts,css,json,yml,yaml,html,twig}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,neon}]
indent_size = 4

[Makefile]
indent_style = tab
