#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Consola de la aplicación.
 *
 * Se cablea a mano y no contra el contenedor web: los comandos son pocos y
 * sus dependencias explícitas; el contenedor sigue siendo solo de la web.
 */

use App\Core\Audit\AuditoriaService;
use App\Core\Auth\HasherPassword;
use App\Core\Database\ConexionFactory;
use App\Core\Database\ConfigBaseDatos;
use App\Modules\Busqueda\Command\IndexarCommand;
use App\Modules\Busqueda\Repository\IndiceBusquedaRepository;
use App\Modules\Busqueda\Service\IndexadorService;
use App\Modules\Contenido\Command\ContenidoProgramadoCommand;
use App\Modules\Contenido\Service\ProgramadorPublicacionService;
use App\Modules\Cumplimiento\Command\SembrarCumplimientoCommand;
use App\Modules\Directorio\Command\SembrarDirectorioCommand;
use App\Adapters\Correo\NotificadorSymfonyMailer;
use App\Modules\Tramites\Command\AlertasVencimientoCommand;
use App\Modules\Tramites\Command\SembrarFestivosCommand;
use App\Modules\Tramites\Repository\TramiteRepository;
use App\Modules\Tramites\Command\SembrarTramitesCommand;
use App\Modules\Transparencia\Command\SembrarTransparenciaCommand;
use App\Modules\Sistema\Command\CrearAdminCommand;
use App\Modules\Sistema\Command\SembrarConfiguracionCommand;
use App\Modules\Sistema\Command\SembrarMenusCommand;
use App\Modules\Sistema\Command\SembrarRedireccionesCommand;
use App\Modules\Sistema\Repository\RedireccionRepository;
use Symfony\Component\Console\Application;

$env = require dirname(__DIR__) . '/config/bootstrap.php';

$conexion = ConexionFactory::crear(ConfigBaseDatos::desde($env));
$auditoria = new AuditoriaService($conexion);
$indexador = new IndexadorService($conexion, new IndiceBusquedaRepository($conexion));

$aplicacion = new Application('E.S.E. Hospital Rosario Pumarejo de López — consola', 'fase-0');
$aplicacion->add(new CrearAdminCommand($conexion, new HasherPassword(), $auditoria));
$aplicacion->add(new SembrarConfiguracionCommand($conexion, $auditoria));
$aplicacion->add(new SembrarMenusCommand($conexion, $auditoria));
$aplicacion->add(new SembrarDirectorioCommand($conexion, $auditoria));
$aplicacion->add(new SembrarTransparenciaCommand($conexion, $auditoria));
$aplicacion->add(new SembrarFestivosCommand($conexion));
$aplicacion->add(new SembrarTramitesCommand($conexion, $auditoria));
$aplicacion->add(new SembrarCumplimientoCommand($conexion, $auditoria));
$aplicacion->add(new AlertasVencimientoCommand(
    new TramiteRepository($conexion),
    NotificadorSymfonyMailer::desde($env),
    $auditoria,
));
$aplicacion->add(new ContenidoProgramadoCommand(new ProgramadorPublicacionService($conexion, $auditoria, $indexador)));
$aplicacion->add(new IndexarCommand($indexador));
$aplicacion->add(new SembrarRedireccionesCommand(new RedireccionRepository($conexion)));
$aplicacion->run();
